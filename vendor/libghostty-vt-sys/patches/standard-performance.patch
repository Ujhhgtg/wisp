+test "standard DCS allocation stays lazy and recovers from failure" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 24, .rows = 6 });
+    defer t.deinit(testing.allocator);
+    const Capture = struct {
+        var response: [256]u8 = undefined;
+        var length: usize = 0;
+        fn writePty(_: *Handler, data: [:0]const u8) void {
+            @memcpy(response[length..][0..data.len], data);
+            length += data.len;
+        }
+    };
+    Capture.length = 0;
+    var handler: Handler = .init(&t);
+    handler.effects.write_pty = &Capture.writePty;
+    var parser: Stream = .initAlloc(testing.allocator, handler);
+    defer parser.deinit();
+    parser.nextSlice("hello\x1b[0m\x1b]2;title\x07");
+    try testing.expectEqual(@as(?*dcs.Handler, null), parser.handler.dcs_handler);
+    {
+        const allocator = t.screens.active.alloc;
+        t.screens.active.alloc = testing.failing_allocator;
+        defer t.screens.active.alloc = allocator;
+        parser.nextSlice("\x1bP$qm\x1b\\");
+    }
+    try testing.expectEqual(@as(usize, 0), Capture.length);
+    try testing.expectEqual(@as(?*dcs.Handler, null), parser.handler.dcs_handler);
+    parser.nextSlice("\x1bP$qm\x1b\\");
+    try testing.expectEqualStrings("\x1bP1$r0m\x1b\\", Capture.response[0..Capture.length]);
+    const allocated = parser.handler.dcs_handler;
+    try testing.expect(allocated != null);
+    Capture.length = 0;
+    parser.nextSlice("\x1bP$qz\x1b\\");
+    try testing.expectEqualStrings("\x1bP0$r\x1b\\", Capture.response[0..Capture.length]);
+    try testing.expectEqual(allocated, parser.handler.dcs_handler);
+}
