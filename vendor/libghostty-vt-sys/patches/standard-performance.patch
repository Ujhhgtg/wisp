+
+const InvalidOscTestHandler = struct {
+    printed: [512]u32 = @splat(0),
+    printed_len: usize = 0,
+    title: [128]u8 = @splat(0),
+    title_len: usize = 0,
+    bells: usize = 0,
+
+    pub fn vt(
+        self: *@This(),
+        comptime action: Action.Tag,
+        value: Action.Value(action),
+    ) void {
+        switch (action) {
+            .print => {
+                self.printed[self.printed_len] = value.cp;
+                self.printed_len += 1;
+            },
+            .print_slice => {
+                @memcpy(self.printed[self.printed_len..][0..value.cps.len], value.cps);
+                self.printed_len += value.cps.len;
+            },
+            .window_title => {
+                @memset(&self.title, 0);
+                @memcpy(self.title[0..value.title.len], value.title);
+                self.title_len = value.title.len;
+            },
+            .bell => self.bells += 1,
+            else => {},
+        }
+    }
+};
+
+test "stream: invalid OSC preserves terminators and cancellation" {
+    const endings = [_][]const u8{ "\x07", "\x1b\\", "\x18", "\x1a" };
+    for (endings) |ending| {
+        var parser: Stream(InvalidOscTestHandler) = .init(.{});
+        parser.nextSlice("\x1b]6;" ++ "discarded ASCII payload " ** 8);
+        try testing.expectEqual(.osc_string, parser.parser.state);
+        try testing.expectEqual(.invalid, parser.parser.osc_parser.state);
+        parser.nextSlice(ending);
+        parser.nextSlice("\x1b]2;ready\x07END");
+        try testing.expectEqual(.ground, parser.parser.state);
+        try testing.expectEqualStrings("ready", parser.handler.title[0..parser.handler.title_len]);
+        try testing.expectEqualSlices(u32, &.{ 'E', 'N', 'D' }, parser.handler.printed[0..parser.handler.printed_len]);
+        try testing.expectEqual(@as(usize, 0), parser.handler.bells);
+    }
+}
+
+test "stream: invalid OSC vector boundaries preserve every byte" {
+    const positions = [_]usize{ 15, 16, 17, 31, 32, 33, 63, 64, 65 };
+    for (positions) |position| for (0..256) |byte| {
+        var input: [128]u8 = undefined;
+        input[0..4].* = "\x1b]6;".*;
+        @memset(input[4 .. 4 + position], 'x');
+        input[4 + position] = @intCast(byte);
+        const suffix = "\x07\x1b]2;ready\x1b\\END";
+        @memcpy(input[5 + position ..][0..suffix.len], suffix);
+        const bytes = input[0 .. 5 + position + suffix.len];
+
+        var bulk: Stream(InvalidOscTestHandler) = .init(.{});
+        bulk.nextSlice(bytes);
+        var scalar: Stream(InvalidOscTestHandler) = .init(.{});
+        for (bytes) |value| scalar.next(value);
+        try testing.expectEqual(scalar.parser.state, bulk.parser.state);
+        try testing.expectEqualDeep(scalar.handler, bulk.handler);
+    };
+}
+
+test "stream: invalid OSC input chunk boundaries match scalar path" {
+    const bytes = "\x1b]6;" ++ "discarded payload " ** 8 ++
+        "\x7f\x00\x08\xc3\xa9\x1b\\\x1b]2;ready\x07END";
+    var scalar: Stream(InvalidOscTestHandler) = .init(.{});
+    for (bytes) |byte| scalar.next(byte);
+
+    for (0..bytes.len + 1) |split| {
+        var bulk: Stream(InvalidOscTestHandler) = .init(.{});
+        bulk.nextSlice(bytes[0..split]);
+        bulk.nextSlice(bytes[split..]);
+        try testing.expectEqual(scalar.parser.state, bulk.parser.state);
+        try testing.expectEqualDeep(scalar.handler, bulk.handler);
+    }
+}
