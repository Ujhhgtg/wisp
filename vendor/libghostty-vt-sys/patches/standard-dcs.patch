+    fn dcsCommand(self: *Handler, command: *dcs.Command) !void {
+        if (self.effects.write_pty == null) return;
+        switch (command.*) {
+            .tmux => {},
+            .xtgettcap => |*request| {
+                const map = comptime terminfo.ghostty.xtgettcapMap();
+                while (request.next()) |key| {
+                    if (map.get(key)) |response| {
+                        var buffer: [4096]u8 = undefined;
+                        const terminated = try std.fmt.bufPrintZ(&buffer, "{s}", .{response});
+                        self.writePty(terminated);
+                    } else if (key.len <= 128) {
+                        var buffer: [138]u8 = undefined;
+                        const response = try std.fmt.bufPrintZ(&buffer, "\x1bP0+r{s}\x1b\\", .{key});
+                        self.writePty(response);
+                    }
+                }
+            },
+            .decrqss => |request| {
+                var response: [256]u8 = undefined;
+                var output = std.io.fixedBufferStream(&response);
+                const writer = output.writer();
+                const prefix_len = "\x1bP0$r".len;
+                output.pos = prefix_len;
+                switch (request) {
+                    .none => {},
+                    .sgr => {
+                        const attributes = try self.terminal.printAttributes(output.buffer[output.pos..]);
+                        output.pos += attributes.len;
+                        try writer.writeByte('m');
+                    },
+                    .decscusr => {
+                        const blink = self.terminal.modes.get(.cursor_blinking);
+                        const style: u8 = switch (self.terminal.screens.active.cursor.cursor_style) {
+                            .block, .block_hollow => if (blink) 1 else 2,
+                            .underline => if (blink) 3 else 4,
+                            .bar => if (blink) 5 else 6,
+                        };
+                        try writer.print("{d} q", .{style});
+                    },
+                    .decsca => try writer.print("{d}\"q", .{@intFromBool(self.terminal.screens.active.cursor.protected)}),
+                    .decstbm => try writer.print("{d};{d}r", .{
+                        self.terminal.scrolling_region.top + 1,
+                        self.terminal.scrolling_region.bottom + 1,
+                    }),
+                    .decslrm => if (self.terminal.modes.get(.enable_left_and_right_margin)) {
+                        try writer.print("{d};{d}s", .{
+                            self.terminal.scrolling_region.left + 1,
+                            self.terminal.scrolling_region.right + 1,
+                        });
+                    },
+                }
+                const valid = output.pos > prefix_len;
+                try writer.writeAll("\x1b\\");
+                _ = try std.fmt.bufPrint(response[0..prefix_len], "\x1bP{d}$r", .{@intFromBool(valid)});
+                response[output.pos] = 0;
+                self.writePty(response[0..output.pos :0]);
+            },
+        }
+    }
