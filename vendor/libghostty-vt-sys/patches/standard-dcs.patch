+    s.nextSlice("\x1b[2;5r\x1bP$qr\x1b\\");
+    try testing.expectEqualStrings("\x1bP1$r2;5r\x1b\\", Capture.response[0..Capture.length]);
+    Capture.length = 0;
+    s.nextSlice("\x1b[1\"q\x1bP$q\"q\x1b\\");
