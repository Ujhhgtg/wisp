+test "standard host reset restores configured cursor appearance" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 24, .rows = 6 });
+    defer t.deinit(testing.allocator);
+    var handler: Handler = .init(&t);
+    handler.default_cursor_style = .bar;
+    handler.default_cursor_blink = true;
+    var s: Stream = .initAlloc(testing.allocator, handler);
+    defer s.deinit();
+    s.nextSlice("\x1b[2 q");
+    try testing.expectEqual(Screen.CursorStyle.block, t.screens.active.cursor.cursor_style);
+    try testing.expect(!t.modes.get(.cursor_blinking));
+    s.nextSlice("\x1b[!p");
+    try testing.expectEqual(Screen.CursorStyle.bar, t.screens.active.cursor.cursor_style);
+    try testing.expect(t.modes.get(.cursor_blinking));
+    try testing.expect(s.handler.default_cursor);
+}
