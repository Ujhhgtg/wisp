+        fn printableRunLength(cps: []const u32) usize {
+            var end: usize = 0;
+            if (comptime std.simd.suggestVectorLength(u32)) |vector_len| {
+                const CodepointVector = @Vector(vector_len, u32);
+                while (end + vector_len <= cps.len) {
+                    const values: CodepointVector = cps[end..][0..vector_len].*;
+                    const controls = (values <= @as(CodepointVector, @splat(0x1F))) |
+                        (values == @as(CodepointVector, @splat(0x7F)));
+                    if (std.simd.firstTrue(controls)) |index| return end + index;
+                    end += vector_len;
+                }
+            }
+            while (end < cps.len and cps[end] > 0x1F and cps[end] != 0x7F) end += 1;
+            return end;
+        }
