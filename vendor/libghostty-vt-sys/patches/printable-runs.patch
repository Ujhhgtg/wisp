+
+test "stream: printable run vector boundaries preserve controls" {
+    const positions = [_]usize{ 0, 1, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65 };
+    for (positions) |position| for (0..128) |control| {
+        var cps: [96]u32 = @splat(0x4E00);
+        cps[position] = @intCast(control);
+        const expected = if (control <= 0x1F or control == 0x7F) position else cps.len;
+        try testing.expectEqual(expected, Stream(InvalidOscTestHandler).printableRunLength(&cps));
+    };
+    try testing.expectEqual(@as(usize, 0), Stream(InvalidOscTestHandler).printableRunLength(&.{}));
+}
+
+test "stream: printable run bulk matches scalar for every byte" {
+    const positions = [_]usize{ 0, 1, 3, 4, 7, 8, 15, 16, 31, 32, 63, 64 };
+    for (positions) |position| for (0..256) |value| {
+        var input: [160]u8 = undefined;
+        @memset(input[0..position], 'x');
+        input[position] = @intCast(value);
+        const suffix = "\x18\x1b[0m\xe4\xb8\xad\xc3\xa9END";
+        @memcpy(input[position + 1 ..][0..suffix.len], suffix);
+        const bytes = input[0 .. position + 1 + suffix.len];
+        var bulk: Stream(InvalidOscTestHandler) = .init(.{});
+        bulk.nextSlice(bytes);
+        var scalar: Stream(InvalidOscTestHandler) = .init(.{});
+        for (bytes) |byte| scalar.next(byte);
+        try testing.expectEqual(scalar.parser.state, bulk.parser.state);
+        try testing.expectEqualDeep(scalar.handler, bulk.handler);
+    };
+}
