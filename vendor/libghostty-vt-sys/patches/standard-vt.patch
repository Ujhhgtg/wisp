+test "standard VT default TBC and DEL preserve terminal cells" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 24, .rows = 4 });
+    defer t.deinit(testing.allocator);
+    var s: Stream = .initAlloc(testing.allocator, .init(&t));
+    defer s.deinit();
+
+    s.nextSlice("A\x7fB\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1c\x1d\x1e\x1fC");
+    try testing.expectEqual(@as(usize, 3), t.screens.active.cursor.x);
+    const text = try t.plainString(testing.allocator);
+    defer testing.allocator.free(text);
+    try testing.expectEqualStrings("ABC", text);
+    s.nextSlice("\x1b[3g\x1b[5G\x1bH\x1b[9G\x1bH\x1b[5G\x1b[g\r\t");
+    try testing.expectEqual(@as(usize, 8), t.screens.active.cursor.x);
+    s.next('\x7f');
+    try testing.expectEqual(@as(usize, 8), t.screens.active.cursor.x);
+}
+
+test "standard VT ANSI mode queries report known and unknown modes" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 24, .rows = 4 });
+    defer t.deinit(testing.allocator);
+    const Capture = struct {
+        var response: [64]u8 = undefined;
+        var length: usize = 0;
+        fn writePty(_: *Handler, data: [:0]const u8) void {
+            @memcpy(response[0..data.len], data);
+            length = data.len;
+        }
+    };
+    var handler: Handler = .init(&t);
+    handler.effects.write_pty = &Capture.writePty;
+    var s: Stream = .initAlloc(testing.allocator, handler);
+    defer s.deinit();
+    s.nextSlice("\x1b[4$p");
+    try testing.expectEqualStrings("\x1b[4;2$y", Capture.response[0..Capture.length]);
+    s.nextSlice("\x1b[4h\x1b[4$p");
+    try testing.expectEqualStrings("\x1b[4;1$y", Capture.response[0..Capture.length]);
+    s.nextSlice("\x1b[9999$p");
+    try testing.expectEqualStrings("\x1b[9999;0$y", Capture.response[0..Capture.length]);
+}
+
+test "standard VT DECSTR preserves position text history and tabs" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 24, .rows = 6 });
+    defer t.deinit(testing.allocator);
+    var s: Stream = .initAlloc(testing.allocator, .init(&t));
+    defer s.deinit();
+    s.nextSlice("KEEP\x1b[3g\x1b[6G\x1bH\x1b[3;7H\x1b7\x1b[1;31m\x1b[4h\x1b[?6h\x1b[?25l\x1b[2;5r\x1b[?69h\x1b[4;18s\x1b[1\"q\x1b(0\x1b[4;10H");
+    const x = t.screens.active.cursor.x;
+    const y = t.screens.active.cursor.y;
+    s.nextSlice("\x1b[!p");
+    try testing.expectEqual(x, t.screens.active.cursor.x);
+    try testing.expectEqual(y, t.screens.active.cursor.y);
+    try testing.expect(t.modes.get(.cursor_visible));
+    try testing.expect(!t.modes.get(.insert));
+    try testing.expect(!t.modes.get(.origin));
+    try testing.expect(!t.modes.get(.enable_left_and_right_margin));
+    try testing.expect(t.modes.get(.wraparound));
+    try testing.expect(t.screens.active.cursor.style.default());
+    try testing.expect(!t.screens.active.cursor.protected);
+    try testing.expectEqual(@as(usize, 0), t.scrolling_region.top);
+    try testing.expectEqual(@as(usize, 5), t.scrolling_region.bottom);
+    try testing.expectEqual(@as(usize, 0), t.scrolling_region.left);
+    try testing.expectEqual(@as(usize, 23), t.scrolling_region.right);
+    const text = try t.plainString(testing.allocator);
+    defer testing.allocator.free(text);
+    try testing.expectEqualStrings("KEEP", text);
+    s.nextSlice("\x1b8");
+    try testing.expectEqual(@as(usize, 0), t.screens.active.cursor.x);
+    try testing.expectEqual(@as(usize, 0), t.screens.active.cursor.y);
+    s.nextSlice("\t");
+    try testing.expectEqual(@as(usize, 5), t.screens.active.cursor.x);
+}
