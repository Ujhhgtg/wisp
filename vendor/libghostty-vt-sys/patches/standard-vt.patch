+pub fn softReset(self: *Terminal) void {
+    self.modes.set(.cursor_visible, true);
+    self.modes.set(.insert, false);
+    self.modes.set(.origin, false);
+    self.modes.set(.disable_keyboard, false);
+    self.modes.set(.keypad_keys, false);
+    self.modes.set(.cursor_keys, false);
+    self.modes.set(.wraparound, self.modes.default.wraparound);
+    self.modes.set(.reverse_wrap, false);
+    self.modes.set(.reverse_wrap_extended, false);
+    self.modes.set(.enable_left_and_right_margin, false);
+    self.modes.set(.synchronized_output, false);
+    self.screens.active.setAttribute(.unset) catch unreachable;
+    self.screens.active.cursor.protected = false;
+    self.screens.active.cursor.pending_wrap = false;
+    self.screens.active.protected_mode = .off;
+    self.screens.active.charset = .{};
+    self.screens.active.saved_cursor = null;
+    self.previous_char = null;
+    self.status_display = .main;
+    self.scrolling_region = .{
+        .top = 0,
+        .bottom = self.rows - 1,
+        .left = 0,
+        .right = self.cols - 1,
+    };
+    self.flags.dirty.clear = true;
+}
+
