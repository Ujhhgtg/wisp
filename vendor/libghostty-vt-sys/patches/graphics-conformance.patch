+test "kittygfx automatic ids skip explicit ids and zero after wrap" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try Terminal.init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+    const storage = &t.screens.active.kitty_images;
+
+    for ([_][]const u8{
+        "a=t,i=2147483647,f=32,s=1,v=1;/wAA/w==",
+        "a=t,I=9,f=32,s=1,v=1;AP8A/w==",
+        "a=t,i=4294967295,f=32,s=1,v=1;AAD//w==",
+    }) |input| {
+        const cmd = try command.Parser.parseString(alloc, input);
+        defer cmd.deinit(alloc);
+        const response = execute(alloc, &t, &cmd).?;
+        try testing.expect(response.ok());
+    }
+    try testing.expect(storage.imageById(2147483647) != null);
+    try testing.expectEqual(@as(u32, 2147483648), storage.imageByNumber(9).?.id);
+    storage.next_image_id = std.math.maxInt(u32);
+    const cmd = try command.Parser.parseString(alloc, "a=t,I=10,f=32,s=1,v=1;AAD//w==");
+    defer cmd.deinit(alloc);
+    const response = execute(alloc, &t, &cmd).?;
+    try testing.expect(response.ok());
+    try testing.expectEqual(@as(u32, 1), response.id);
+}
+
+test "kittygfx delete aborts a partial transmission before the next image" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try Terminal.init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+    const storage = &t.screens.active.kitty_images;
+
+    const partial = try command.Parser.parseString(alloc, "a=t,i=7,f=32,s=1,v=2,m=1;/wAA/w==");
+    defer partial.deinit(alloc);
+    try testing.expect(execute(alloc, &t, &partial) == null);
+    try testing.expect(storage.loading != null);
+    const erase = try command.Parser.parseString(alloc, "a=d,d=i,i=7");
+    defer erase.deinit(alloc);
+    try testing.expect(execute(alloc, &t, &erase) == null);
+    try testing.expect(storage.loading == null);
+    const replacement = try command.Parser.parseString(alloc, "a=t,i=8,f=32,s=1,v=1;AAD//w==");
+    defer replacement.deinit(alloc);
+    try testing.expect(execute(alloc, &t, &replacement).?.ok());
+    try testing.expectEqual(@as(usize, 4), storage.imageById(8).?.data.len);
+}
