+pub fn image_by_number(
+    graphics_: KittyGraphics,
+    image_number: u32,
+) callconv(lib.calling_conv) ImageHandle {
+    if (comptime !build_options.kitty_graphics) return null;
+
+    const storage = graphics_;
+    const image = storage.imageByNumber(image_number) orelse return null;
+    return storage.images.getPtr(image.id);
+}
+
+test "image_by_number borrows the newest image and reports missing numbers" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    const alloc = testing.allocator;
+    var t = try Terminal.init(alloc, .{ .cols = 8, .rows = 4 });
+    defer t.deinit(alloc);
+    const storage = &t.screens.active.kitty_images;
+    try storage.addImage(alloc, .{ .id = 11, .number = 9, .width = 1, .height = 1 });
+    try storage.addImage(alloc, .{ .id = 12, .number = 9, .width = 2, .height = 1 });
+    try testing.expectEqual(storage.images.getPtr(12), image_by_number(storage, 9));
+    try testing.expect(image_by_number(storage, 8) == null);
+}
